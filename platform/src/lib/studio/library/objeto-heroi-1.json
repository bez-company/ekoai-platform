{
  "id": "objeto-heroi-1",
  "territory": "objeto-heroi",
  "meta": {
    "tone": "dark",
    "needsImage": true,
    "imageSlot": "Uma foto de estúdio de um único objeto simbólico bem no centro ou na base inferior, com luz lateral dramática, sombra longa e reflexo, deixando bastante espaço vazio (negativo) na parte superior e inferior.",
    "slots": {
      "headline": {
        "max": 40
      },
      "support": {
        "max": 90
      }
    },
    "summary": "Objeto hero iluminado de forma dramática, com título forte isolado no canto superior e amplo espaço negativo."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Template Objeto em Destaque</title>\n  <style>\n    :root {\n      --bg: #121418;\n      --ink: #ffffff;\n      --accent: #ff5533;\n      --muted: #8a8d91;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n    }\n\n    .asset-hero {\n      position: absolute;\n      top: 150px;\n      left: 0;\n      width: 1080px;\n      height: 1050px;\n      object-fit: cover;\n      z-index: 1;\n    }\n\n    .gradient-top {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 450px;\n      background: linear-gradient(to bottom, var(--bg) 20%, color-mix(in srgb, var(--bg) 80%, transparent) 60%, transparent 100%);\n      z-index: 2;\n    }\n\n    .gradient-bottom {\n      position: absolute;\n      bottom: 0;\n      left: 0;\n      width: 1080px;\n      height: 300px;\n      background: linear-gradient(to top, var(--bg) 30%, color-mix(in srgb, var(--bg) 80%, transparent) 70%, transparent 100%);\n      z-index: 2;\n    }\n\n    .headline {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 920px;\n      height: 160px;\n      font-family: var(--display);\n      font-weight: 700;\n      color: var(--ink);\n      font-size: 80px;\n      line-height: 1.1;\n      overflow: hidden;\n      z-index: 3;\n    }\n\n    .accent-line {\n      position: absolute;\n      top: 260px;\n      left: 80px;\n      width: 60px;\n      height: 4px;\n      background-color: var(--accent);\n      z-index: 3;\n    }\n\n    .support {\n      position: absolute;\n      top: 300px;\n      left: 80px;\n      width: 600px;\n      height: 120px;\n      font-family: var(--body);\n      font-weight: 400;\n      color: color-mix(in srgb, var(--ink) 85%, var(--bg));\n      font-size: 32px;\n      line-height: 1.3;\n      overflow: hidden;\n      z-index: 3;\n    }\n\n    .handle {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 400px;\n      height: 40px;\n      font-family: var(--body);\n      font-weight: 600;\n      color: var(--ink);\n      font-size: 28px;\n      line-height: 40px;\n      letter-spacing: 1px;\n      overflow: hidden;\n      z-index: 3;\n    }\n\n    .logo {\n      position: absolute;\n      bottom: 80px;\n      right: 80px;\n      height: 64px;\n      width: 300px;\n      object-fit: contain;\n      object-position: right center;\n      z-index: 3;\n    }\n  </style>\n</head>\n<body>\n\n  <img src=\"{{asset:hero}}\" alt=\"\" class=\"asset-hero\">\n  \n  <div class=\"gradient-top\"></div>\n  <div class=\"gradient-bottom\"></div>\n\n  <h1 class=\"headline\" data-fit=\"headline\">{{slot:headline}}</h1>\n  <div class=\"accent-line\"></div>\n  <p class=\"support\" data-fit=\"support\">{{slot:support}}</p>\n\n  <p class=\"handle\" data-fit=\"handle\">{{handle}}</p>\n  <img src=\"{{logo:on-dark}}\" alt=\"Logo\" class=\"logo\">\n\n</body>\n</html>"
}
