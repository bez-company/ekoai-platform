{
  "id": "colagem-editorial-3",
  "territory": "colagem-editorial",
  "meta": {
    "tone": "light",
    "needsImage": true,
    "imageSlot": "A cutout image (object or person, isolated, no background, no identifiable face) to be placed over the accent shape in the upper right. The bottom half is reserved for text.",
    "slots": {
      "headline": {
        "max": 60
      },
      "support": {
        "max": 100
      }
    },
    "summary": "Composição em estilo colagem com papel recortado, fita adesiva, textura de grão e sobreposição de recorte fotográfico sobre forma geométrica."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #F5F2EB;\n      --ink: #1A1A1A;\n      --accent: #E55938;\n      --muted: #D1CEC5;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      margin: 0;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--muted);\n      font-family: var(--body);\n    }\n\n    .noise {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      opacity: 0.4;\n      pointer-events: none;\n      z-index: 100;\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n    }\n\n    .paper-sheet {\n      position: absolute;\n      top: 40px;\n      left: 40px;\n      width: 1000px;\n      height: 1270px;\n      background-color: var(--bg);\n      clip-path: polygon(\n        1% 1%, 98% 2%, 100% 30%, 99% 70%, 98% 99%, \n        70% 100%, 30% 98%, 2% 99%, 0% 60%, 1% 20%\n      );\n      filter: drop-shadow(0 15px 25px rgba(0,0,0,0.15));\n      z-index: 10;\n    }\n\n    .tape {\n      position: absolute;\n      background-color: color-mix(in srgb, var(--bg) 80%, transparent);\n      border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);\n      box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n      z-index: 30;\n      opacity: 0.9;\n    }\n\n    .tape-1 {\n      top: 15px;\n      left: 500px;\n      width: 160px;\n      height: 45px;\n      transform: rotate(-3deg);\n    }\n\n    .tape-2 {\n      bottom: 25px;\n      left: 100px;\n      width: 140px;\n      height: 40px;\n      transform: rotate(5deg);\n    }\n\n    .accent-shape {\n      position: absolute;\n      top: 80px;\n      right: 60px;\n      width: 580px;\n      height: 620px;\n      background-color: var(--accent);\n      clip-path: polygon(20% 0%, 100% 10%, 90% 90%, 0% 100%, 10% 20%);\n      z-index: 12;\n    }\n\n    .hero-image {\n      position: absolute;\n      top: 60px;\n      right: 40px;\n      width: 650px;\n      height: 680px;\n      object-fit: contain;\n      z-index: 15;\n    }\n\n    .headline-box {\n      position: absolute;\n      top: 760px;\n      left: 80px;\n      width: 920px;\n      height: 260px;\n      overflow: hidden;\n      z-index: 20;\n    }\n\n    .headline-box h1 {\n      font-family: var(--display);\n      color: var(--ink);\n      font-size: 85px;\n      line-height: 1.05;\n      text-transform: uppercase;\n      font-weight: bold;\n    }\n\n    .support-box {\n      position: absolute;\n      top: 1040px;\n      left: 80px;\n      width: 600px;\n      height: 120px;\n      overflow: hidden;\n      z-index: 20;\n    }\n\n    .support-box p {\n      font-family: var(--body);\n      color: var(--ink);\n      font-size: 28px;\n      line-height: 1.3;\n      font-weight: 400;\n    }\n\n    .handle-box {\n      position: absolute;\n      top: 1190px;\n      left: 80px;\n      width: 400px;\n      height: 40px;\n      overflow: hidden;\n      z-index: 20;\n    }\n\n    .handle-box p {\n      font-family: var(--body);\n      color: var(--ink);\n      font-size: 28px;\n      font-weight: bold;\n      letter-spacing: 0.05em;\n    }\n\n    .logo-box {\n      position: absolute;\n      top: 1170px;\n      right: 80px;\n      width: 250px;\n      height: 80px;\n      overflow: hidden;\n      z-index: 20;\n      display: flex;\n      justify-content: flex-end;\n      align-items: center;\n    }\n\n    .logo-box img {\n      max-width: 100%;\n      max-height: 100%;\n      object-fit: contain;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"tape tape-1\"></div>\n  <div class=\"tape tape-2\"></div>\n  \n  <div class=\"paper-sheet\"></div>\n  \n  <div class=\"accent-shape\"></div>\n  <img src=\"{{asset:hero}}\" alt=\"\" class=\"hero-image\">\n\n  <div class=\"headline-box\">\n    <h1 data-fit=\"headline\">{{slot:headline}}</h1>\n  </div>\n\n  <div class=\"support-box\">\n    <p data-fit=\"support\">{{slot:support}}</p>\n  </div>\n\n  <div class=\"handle-box\">\n    <p data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n  <div class=\"logo-box\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"noise\"></div>\n</body>\n</html>"
}
