{
  "id": "diagrama-didatico-2",
  "territory": "diagrama-didatico",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 60
      },
      "step1": {
        "max": 75
      },
      "step2": {
        "max": 75
      },
      "step3": {
        "max": 75
      },
      "step4": {
        "max": 75
      }
    },
    "summary": "Diagrama de espinha dorsal com 4 passos alternados e números desenhados em SVG, estilo anotação estruturada."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Template Instagram</title>\n  <style>\n    :root {\n      --bg: #F5F2EB;\n      --ink: #111111;\n      --accent: #D94824;\n      --muted: #8A857D;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n      --hand: 'Caveat', cursive;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      background-color: var(--bg);\n      position: relative;\n      overflow: hidden;\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* SVG Background Lines */\n    .diagram-svg {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      z-index: 1;\n      pointer-events: none;\n    }\n    \n    .diagram-path {\n      fill: none;\n      stroke: var(--accent);\n      stroke-width: 3;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      stroke-dasharray: 8 8;\n    }\n\n    .solid-path {\n      fill: none;\n      stroke: color-mix(in srgb, var(--ink) 20%, var(--bg));\n      stroke-width: 4;\n      stroke-linecap: round;\n    }\n\n    /* Slots */\n    .headline-box {\n      position: absolute;\n      top: 100px;\n      left: 80px;\n      width: 920px;\n      height: 160px;\n      overflow: hidden;\n      z-index: 2;\n    }\n    .headline-text {\n      font-family: var(--display);\n      font-weight: 700;\n      color: var(--ink);\n      font-size: 60px;\n      line-height: 1.1;\n      text-align: center;\n    }\n\n    .step-box {\n      position: absolute;\n      width: 380px;\n      height: 140px;\n      overflow: hidden;\n      z-index: 2;\n    }\n    .step-text {\n      font-family: var(--hand);\n      font-size: 38px;\n      line-height: 1.2;\n      color: var(--ink);\n    }\n    \n    .step-box.left { left: 80px; text-align: right; }\n    .step-box.right { left: 620px; text-align: left; }\n\n    #step1-box { top: 320px; }\n    #step2-box { top: 520px; }\n    #step3-box { top: 720px; }\n    #step4-box { top: 920px; }\n\n    /* Number Nodes */\n    .node {\n      position: absolute;\n      width: 60px;\n      height: 60px;\n      background-color: var(--bg);\n      border: 3px solid var(--accent);\n      border-radius: 50%;\n      z-index: 3;\n      left: 510px;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    .node svg {\n      width: 30px;\n      height: 30px;\n      stroke: var(--ink);\n      stroke-width: 3;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      fill: none;\n    }\n\n    #node1 { top: 360px; }\n    #node2 { top: 560px; }\n    #node3 { top: 760px; }\n    #node4 { top: 960px; }\n\n    /* Bottom Elements */\n    .logo-box {\n      position: absolute;\n      bottom: 80px;\n      right: 80px;\n      height: 60px;\n      z-index: 2;\n    }\n    .logo-box img {\n      height: 100%;\n      width: auto;\n    }\n\n    .handle-box {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 400px;\n      height: 40px;\n      overflow: hidden;\n      z-index: 2;\n    }\n    .handle-text {\n      font-family: var(--body);\n      font-weight: 700;\n      font-size: 28px;\n      color: color-mix(in srgb, var(--ink) 60%, var(--bg));\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Structural Lines -->\n  <svg class=\"diagram-svg\" viewBox=\"0 0 1080 1350\">\n    <!-- Spine -->\n    <path class=\"solid-path\" d=\"M 540 280 L 540 1080\" />\n    \n    <!-- Branches -->\n    <path class=\"diagram-path\" d=\"M 540 390 L 480 390\" />\n    <path class=\"diagram-path\" d=\"M 540 590 L 600 590\" />\n    <path class=\"diagram-path\" d=\"M 540 790 L 480 790\" />\n    <path class=\"diagram-path\" d=\"M 540 990 L 600 990\" />\n  </svg>\n\n  <!-- Node Markers with Drawn Numbers -->\n  <div class=\"node\" id=\"node1\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M10 8 L14 6 L14 18 M10 18 L18 18\" /></svg>\n  </div>\n  <div class=\"node\" id=\"node2\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M7 9 C7 7 17 6 17 10 C17 14 7 18 7 18 L18 18\" /></svg>\n  </div>\n  <div class=\"node\" id=\"node3\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M7 8 C12 6 16 8 13 12 C16 12 18 16 14 19 C10 20 7 18 7 18\" /></svg>\n  </div>\n  <div class=\"node\" id=\"node4\">\n    <svg viewBox=\"0 0 24 24\"><path d=\"M15 19 L15 5 L6 13 L17 13\" /></svg>\n  </div>\n\n  <!-- Text Slots -->\n  <div class=\"headline-box\">\n    <p class=\"headline-text\" data-fit=\"headline\">{{slot:headline}}</p>\n  </div>\n\n  <div class=\"step-box left\" id=\"step1-box\">\n    <p class=\"step-text\" data-fit=\"step1\">{{slot:step1}}</p>\n  </div>\n\n  <div class=\"step-box right\" id=\"step2-box\">\n    <p class=\"step-text\" data-fit=\"step2\">{{slot:step2}}</p>\n  </div>\n\n  <div class=\"step-box left\" id=\"step3-box\">\n    <p class=\"step-text\" data-fit=\"step3\">{{slot:step3}}</p>\n  </div>\n\n  <div class=\"step-box right\" id=\"step4-box\">\n    <p class=\"step-text\" data-fit=\"step4\">{{slot:step4}}</p>\n  </div>\n\n  <div class=\"handle-box\">\n    <p class=\"handle-text\" data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n  <div class=\"logo-box\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n</body>\n</html>"
}
