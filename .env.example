# Instagram Graph API (Meta for Developers)
# Long-lived user access token (60 dias, renovável automaticamente)
IG_ACCESS_TOKEN=
# ID da conta Instagram Business (não confundir com numeric ID público)
IG_BUSINESS_ACCOUNT_ID=
# App credentials pra refresh de token
META_APP_ID=
META_APP_SECRET=

# LinkedIn API
# Access token OAuth (60 dias)
LINKEDIN_ACCESS_TOKEN=
# Refresh token pra renovar
LINKEDIN_REFRESH_TOKEN=
# URN da pessoa (urn:li:person:XXX) ou organização (urn:li:organization:XXX)
LINKEDIN_AUTHOR_URN=
# App credentials
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Versão da API do LinkedIn (YYYYMM). Cada versão vale ~1 ano; vencida, toda chamada falha.
LINKEDIN_VERSION=202610

# Postgres — estado event-sourced. Em produção é o Cloud SQL (SPEC 010); localmente, qualquer
# Postgres com as migrations de supabase/migrations aplicadas.
# STATE_BACKEND=postgres liga o estado no banco. Sem ele, as leituras (fila, histórico) voltam
# vazias e as escritas falham: serve para teste e dry-run local. O Cloud Run recusa subir sem ele.
DATABASE_URL=
# STATE_BACKEND=postgres

# Mídia (PNG, PDF, vídeo): bucket privado do Cloud Storage. As URLs devolvidas apontam para a
# rota /api/media da plataforma, que lê do bucket. Credencial: service account do job (ADC); em
# desenvolvimento, `gcloud auth application-default login`.
STORAGE_BUCKET=
MEDIA_BASE_URL=

# Conta do job: o backend roda uma conta por execução. Obrigatório, sem padrão (ADR 0010).
TENANT_ID=

# Flags runtime
# DRY_RUN=true             → não chama APIs externas
# METRICS_WINDOW_DAYS=30   → janela de coleta de engajamento no relatório semanal

# Login por pessoa (AUTH_PROVIDER=identity). O servidor lê estas variáveis em runtime e as passa à
# tela de entrada por props; NUNCA como NEXT_PUBLIC_ (a imagem é construída no CI, sem a chave).
# Em produção vêm do Terraform. Em desenvolvimento, FIREBASE_AUTH_EMULATOR_HOST aponta o emulador
# local (a tela e o servidor falam com ele) e dispensa a chave.
# IDENTITY_PROJECT_ID=
# FIREBASE_WEB_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Cadastro (SPEC 011 R2): `invite` (padrão) só entra por convite ou conta criada no console;
# `open` libera POST /api/account para qualquer pessoa com e-mail verificado e duas etapas.
# Só vale com AUTH_PROVIDER=identity. Não abra antes de existir limite de taxa no cadastro.
# SIGNUP_MODE=invite
# PUBLISH_MODE=live  # rehearsal: cria o container na Meta e não publica (ambiente de teste)

# Segundo fator (SPEC 009): `required` (padrão) exige o app autenticador do administrador para entrar,
# criar conta e excluir conta; `optional` não exige em lugar nenhum (quem ativou continua com o código).
# Só vale com AUTH_PROVIDER=identity.
# MFA_MODE=required

# Endereço público da plataforma, base do link do convite. Em produção é obrigatório (o Cloud Run
# enxerga o endereço interno); sem ele, o link usa os cabeçalhos do proxy.
# APP_BASE_URL=https://app.exemplo.com.br
# E-mail transacional: ainda sem provedor. Sem MAIL_PROVIDER, quem convida copia o link na tela.
# Com a variável definida e sem implementação em lib/mailer.ts, o convite falha antes de ser criado.
# MAIL_PROVIDER=

# Plataforma: site da conta, destino dos links com UTM (SPEC 001 R1). Vazio = post sem link rastreado.
SITE_URL=
