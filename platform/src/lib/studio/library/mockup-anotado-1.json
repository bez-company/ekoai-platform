{
  "id": "mockup-anotado-1",
  "territory": "mockup-anotado",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 25
      },
      "extra1": {
        "max": 30
      },
      "extra2": {
        "max": 30
      },
      "note1": {
        "max": 60
      },
      "note2": {
        "max": 60
      }
    },
    "summary": "Um cartão de recibo centralizado com anotações manuscritas flutuantes e setas indicativas."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #f4f4f0;\n      --ink: #1a1a1a;\n      --accent: #ff4a00;\n      --muted: #888888;\n      --display: 'Space Grotesk', sans-serif;\n      --body: 'Inter', sans-serif;\n      --hand: 'Caveat', cursive;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      margin: 0;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* SVG Arrows Canvas */\n    .arrows {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      pointer-events: none;\n      z-index: 5;\n    }\n\n    /* Card */\n    .card {\n      position: absolute;\n      width: 580px;\n      height: 700px;\n      top: 325px;\n      left: 250px;\n      background-color: color-mix(in srgb, var(--bg) 98%, var(--ink));\n      border: 2px solid color-mix(in srgb, var(--ink) 20%, var(--bg));\n      box-shadow: 15px 15px 40px rgba(0, 0, 0, 0.08);\n      transform: rotate(-3deg);\n      border-radius: 12px;\n      z-index: 2;\n      padding: 60px;\n    }\n\n    .card::before {\n      content: '';\n      position: absolute;\n      top: 40px;\n      left: 40px;\n      right: 40px;\n      bottom: 40px;\n      border: 1px dashed color-mix(in srgb, var(--ink) 30%, var(--bg));\n      pointer-events: none;\n    }\n\n    .card-headline-box {\n      position: absolute;\n      top: 100px;\n      left: 80px;\n      width: 420px;\n      height: 120px;\n      overflow: hidden;\n    }\n\n    .card-headline {\n      font-family: var(--display);\n      font-weight: bold;\n      font-size: 48px;\n      line-height: 1.1;\n      color: var(--ink);\n    }\n\n    .card-divider {\n      position: absolute;\n      top: 260px;\n      left: 80px;\n      width: 420px;\n      height: 2px;\n      background-color: color-mix(in srgb, var(--ink) 15%, var(--bg));\n    }\n\n    .card-item-1-box {\n      position: absolute;\n      top: 320px;\n      left: 80px;\n      width: 420px;\n      height: 80px;\n      overflow: hidden;\n    }\n\n    .card-item-2-box {\n      position: absolute;\n      top: 440px;\n      left: 80px;\n      width: 420px;\n      height: 80px;\n      overflow: hidden;\n    }\n\n    .card-item {\n      font-family: var(--body);\n      font-size: 32px;\n      color: color-mix(in srgb, var(--ink) 80%, var(--bg));\n    }\n\n    /* Notes */\n    .note-1-box {\n      position: absolute;\n      top: 120px;\n      left: 560px;\n      width: 440px;\n      height: 180px;\n      overflow: hidden;\n      z-index: 10;\n      transform: rotate(4deg);\n    }\n\n    .note-2-box {\n      position: absolute;\n      top: 1060px;\n      left: 100px;\n      width: 440px;\n      height: 180px;\n      overflow: hidden;\n      z-index: 10;\n      transform: rotate(-2deg);\n    }\n\n    .note-text {\n      font-family: var(--hand);\n      font-size: 46px;\n      line-height: 1.2;\n      color: var(--accent);\n    }\n\n    /* Brand elements */\n    .logo-box {\n      position: absolute;\n      bottom: 80px;\n      right: 80px;\n      width: 200px;\n      height: 64px;\n      display: flex;\n      justify-content: flex-end;\n      align-items: center;\n    }\n\n    .logo-box img {\n      max-width: 100%;\n      max-height: 64px;\n      object-fit: contain;\n    }\n\n    .handle-box {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 400px;\n      height: 40px;\n      overflow: hidden;\n    }\n\n    .handle-text {\n      font-family: var(--body);\n      font-size: 28px;\n      font-weight: bold;\n      color: var(--ink);\n    }\n  </style>\n</head>\n<body>\n\n  <!-- SVG Arrows connecting notes to card -->\n  <svg class=\"arrows\" viewBox=\"0 0 1080 1350\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n    <defs>\n      <marker id=\"arrowhead\" markerWidth=\"10\" markerHeight=\"7\" refX=\"9\" refY=\"3.5\" orient=\"auto\">\n        <polygon points=\"0 0, 10 3.5, 0 7\" fill=\"var(--accent)\" />\n      </marker>\n    </defs>\n    <!-- Arrow from Note 1 to Card Headline -->\n    <path d=\"M 780 310 Q 780 360 680 380\" stroke=\"var(--accent)\" stroke-width=\"4\" stroke-dasharray=\"8 6\" fill=\"none\" marker-end=\"url(#arrowhead)\"/>\n    <!-- Arrow from Note 2 to Card Item 2 -->\n    <path d=\"M 320 1050 Q 320 980 400 950\" stroke=\"var(--accent)\" stroke-width=\"4\" stroke-dasharray=\"8 6\" fill=\"none\" marker-end=\"url(#arrowhead)\"/>\n  </svg>\n\n  <div class=\"card\">\n    <div class=\"card-headline-box\">\n      <div class=\"card-headline\" data-fit=\"headline\">{{slot:headline}}</div>\n    </div>\n    \n    <div class=\"card-divider\"></div>\n    \n    <div class=\"card-item-1-box\">\n      <div class=\"card-item\" data-fit=\"extra1\">{{slot:extra1}}</div>\n    </div>\n    \n    <div class=\"card-item-2-box\">\n      <div class=\"card-item\" data-fit=\"extra2\">{{slot:extra2}}</div>\n    </div>\n  </div>\n\n  <div class=\"note-1-box\">\n    <div class=\"note-text\" data-fit=\"note1\">{{slot:note1}}</div>\n  </div>\n\n  <div class=\"note-2-box\">\n    <div class=\"note-text\" data-fit=\"note2\">{{slot:note2}}</div>\n  </div>\n\n  <div class=\"handle-box\">\n    <p class=\"handle-text\" data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n  <div class=\"logo-box\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n</body>\n</html>"
}
