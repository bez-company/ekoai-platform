{
  "id": "cartaz-retro-1",
  "territory": "cartaz-retro",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "extra1": {
        "max": 30
      },
      "headline": {
        "max": 70
      },
      "support": {
        "max": 120
      }
    },
    "summary": "Pôster estilo risografia com retículas de meio-tom, tipografia impactante e formas geométricas deslocadas simulando erro de registro."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #EAE6DF;\n      --ink: #1C1917;\n      --accent: #E04D36;\n      --muted: #A8A296;\n      --display: 'Oswald', sans-serif;\n      --body: 'Space Grotesk', sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      margin: 0;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n    }\n\n    /* Halftone pattern background */\n    .halftone-bg {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      background-image: radial-gradient(color-mix(in srgb, var(--ink) 18%, transparent) 2px, transparent 2px);\n      background-size: 12px 12px;\n      z-index: 1;\n    }\n\n    /* Solid Background Block to ensure text legibility */\n    .text-backdrop {\n      position: absolute;\n      top: 380px;\n      left: 80px;\n      width: 920px;\n      height: 480px;\n      background-color: var(--bg);\n      border: 4px solid var(--ink);\n      z-index: 2;\n    }\n\n    /* Misaligned Backdrop Shadow (simulating print offset) */\n    .text-backdrop-offset {\n      position: absolute;\n      top: 395px;\n      left: 95px;\n      width: 920px;\n      height: 480px;\n      background-color: color-mix(in srgb, var(--ink) 15%, var(--bg));\n      z-index: 1;\n    }\n\n    /* Accent Graphic (Bottom Right) */\n    .accent-shape-fill {\n      position: absolute;\n      top: 950px;\n      left: 650px;\n      width: 350px;\n      height: 350px;\n      background-color: var(--accent);\n      border-radius: 50%;\n      z-index: 1;\n    }\n\n    .accent-shape-stroke {\n      position: absolute;\n      top: 935px;\n      left: 635px;\n      width: 350px;\n      height: 350px;\n      border: 4px solid var(--ink);\n      border-radius: 50%;\n      z-index: 2;\n    }\n\n    /* Top Elements */\n    .logo-container {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 300px;\n      height: 70px;\n      z-index: 10;\n      overflow: hidden;\n    }\n    \n    .logo-container img {\n      max-width: 100%;\n      height: 70px;\n      object-fit: contain;\n      object-position: left center;\n    }\n\n    .handle-box {\n      position: absolute;\n      top: 80px;\n      left: 700px;\n      width: 300px;\n      height: 40px;\n      z-index: 10;\n      overflow: hidden;\n    }\n\n    .handle-box p {\n      font-family: var(--body);\n      font-weight: bold;\n      font-size: 28px;\n      color: var(--ink);\n      text-align: right;\n      text-transform: uppercase;\n      letter-spacing: 1px;\n    }\n\n    /* Text Slots */\n    .extra1-box {\n      position: absolute;\n      top: 300px;\n      left: 80px;\n      width: 920px;\n      height: 50px;\n      z-index: 10;\n      overflow: hidden;\n    }\n\n    .extra1-box p {\n      font-family: var(--body);\n      font-weight: bold;\n      font-size: 32px;\n      color: var(--ink);\n      text-transform: uppercase;\n      letter-spacing: 2px;\n    }\n\n    .headline-box {\n      position: absolute;\n      top: 420px;\n      left: 120px; /* Inside the backdrop */\n      width: 840px;\n      height: 400px;\n      z-index: 10;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n    }\n\n    .headline-box h1 {\n      font-family: var(--display);\n      font-weight: bold;\n      font-size: 110px;\n      line-height: 1.1;\n      color: var(--ink);\n      text-transform: uppercase;\n      margin: 0;\n    }\n\n    .support-box {\n      position: absolute;\n      top: 1000px;\n      left: 80px;\n      width: 500px; /* Kept away from the accent shape */\n      height: 270px;\n      z-index: 10;\n      overflow: hidden;\n    }\n\n    .support-box p {\n      font-family: var(--body);\n      font-weight: normal;\n      font-size: 36px;\n      line-height: 1.4;\n      color: var(--ink);\n    }\n  </style>\n</head>\n<body>\n  <div class=\"halftone-bg\"></div>\n  \n  <div class=\"text-backdrop-offset\"></div>\n  <div class=\"text-backdrop\"></div>\n  \n  <div class=\"accent-shape-fill\"></div>\n  <div class=\"accent-shape-stroke\"></div>\n\n  <div class=\"logo-container\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"handle-box\">\n    <p data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n  <div class=\"extra1-box\">\n    <p data-fit=\"extra1\">{{slot:extra1}}</p>\n  </div>\n\n  <div class=\"headline-box\">\n    <h1 data-fit=\"headline\">{{slot:headline}}</h1>\n  </div>\n\n  <div class=\"support-box\">\n    <p data-fit=\"support\">{{slot:support}}</p>\n  </div>\n</body>\n</html>"
}
