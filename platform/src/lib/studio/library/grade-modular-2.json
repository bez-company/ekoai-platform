{
  "id": "grade-modular-2",
  "territory": "grade-modular",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 60
      },
      "support": {
        "max": 120
      },
      "extra1": {
        "max": 25
      },
      "extra2": {
        "max": 40
      }
    },
    "summary": "Mosaico assimétrico de seis cartões com hierarquia forte, combinando tipografia e ícones SVG."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #F4F4F0;\n      --ink: #1A1A1A;\n      --accent: #FF5A36;\n      --muted: #8F8F8A;\n      --display: 'Outfit', sans-serif;\n      --body: 'DM Sans', sans-serif;\n    }\n\n    body {\n      margin: 0;\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* Cards Base */\n    .card {\n      position: absolute;\n      border-radius: 32px;\n      overflow: hidden;\n    }\n\n    .card-1 {\n      left: 80px;\n      top: 80px;\n      width: 620px;\n      height: 400px;\n      background-color: color-mix(in srgb, var(--ink) 8%, var(--bg));\n    }\n\n    .card-2 {\n      left: 720px;\n      top: 80px;\n      width: 280px;\n      height: 400px;\n      background-color: color-mix(in srgb, var(--ink) 4%, var(--bg));\n    }\n\n    .card-3 {\n      left: 80px;\n      top: 500px;\n      width: 300px;\n      height: 770px;\n      background-color: color-mix(in srgb, var(--ink) 12%, var(--bg));\n    }\n\n    .card-4 {\n      left: 400px;\n      top: 500px;\n      width: 300px;\n      height: 350px;\n      background-color: var(--accent);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n\n    .card-5 {\n      left: 720px;\n      top: 500px;\n      width: 280px;\n      height: 350px;\n      background-color: color-mix(in srgb, var(--ink) 16%, var(--bg));\n    }\n\n    .card-6 {\n      left: 400px;\n      top: 870px;\n      width: 600px;\n      height: 400px;\n      background-color: color-mix(in srgb, var(--ink) 6%, var(--bg));\n    }\n\n    /* Text Boxes */\n    .text-box {\n      position: absolute;\n      margin: 0;\n      overflow: hidden;\n    }\n\n    .headline-box {\n      left: 120px; /* 80 + 40 */\n      top: 120px;  /* 80 + 40 */\n      width: 540px;\n      height: 320px;\n      font-family: var(--display);\n      font-weight: bold;\n      font-size: 80px;\n      line-height: 1.1;\n      letter-spacing: -0.02em;\n    }\n\n    .support-box {\n      left: 120px; /* 80 + 40 */\n      top: 540px;  /* 500 + 40 */\n      width: 220px;\n      height: 690px;\n      font-size: 36px;\n      line-height: 1.3;\n    }\n\n    .extra1-box {\n      left: 760px; /* 720 + 40 */\n      top: 540px;  /* 500 + 40 */\n      width: 200px;\n      height: 270px;\n      font-family: var(--display);\n      font-weight: bold;\n      font-size: 48px;\n      line-height: 1.1;\n      text-transform: uppercase;\n    }\n\n    .extra2-box {\n      left: 440px; /* 400 + 40 */\n      top: 910px;  /* 870 + 40 */\n      width: 520px;\n      height: 250px;\n      font-size: 42px;\n      line-height: 1.2;\n    }\n\n    .handle-box {\n      left: 440px;\n      top: 1190px; /* 870 + 320 */\n      width: 520px;\n      height: 40px;\n      font-family: var(--display);\n      font-weight: bold;\n      font-size: 28px;\n      color: var(--ink); /* Changed from --muted to --ink for contrast */\n      text-align: right;\n    }\n\n    .logo {\n      position: absolute;\n      left: 760px;\n      top: 120px;\n      height: 64px;\n      width: 200px;\n      object-fit: contain;\n      object-position: top center;\n    }\n\n    /* Graphics */\n    .icon-star {\n      position: absolute;\n      left: 810px;\n      top: 310px;\n      width: 100px;\n      height: 100px;\n      fill: var(--ink);\n    }\n\n    .graphic-accent {\n      width: 180px;\n      height: 180px;\n      fill: var(--bg);\n    }\n  </style>\n</head>\n<body>\n\n  <!-- Card 1 -->\n  <div class=\"card card-1\"></div>\n  <div class=\"text-box headline-box\" data-fit=\"headline\">{{slot:headline}}</div>\n\n  <!-- Card 2 -->\n  <div class=\"card card-2\"></div>\n  <img src=\"{{logo:on-light}}\" alt=\"Logo\" class=\"logo\">\n  <svg class=\"icon-star\" viewBox=\"0 0 24 24\">\n    <path d=\"M12 0L14.59 9.41L24 12L14.59 14.59L12 24L9.41 14.59L0 12L9.41 9.41L12 0Z\"/>\n  </svg>\n\n  <!-- Card 3 -->\n  <div class=\"card card-3\"></div>\n  <div class=\"text-box support-box\" data-fit=\"support\">{{slot:support}}</div>\n\n  <!-- Card 4 -->\n  <div class=\"card card-4\">\n    <svg class=\"graphic-accent\" viewBox=\"0 0 100 100\">\n      <circle cx=\"50\" cy=\"50\" r=\"40\" stroke=\"var(--bg)\" stroke-width=\"8\" fill=\"none\" stroke-dasharray=\"12 12\"/>\n      <circle cx=\"50\" cy=\"50\" r=\"15\" fill=\"var(--bg)\"/>\n    </svg>\n  </div>\n\n  <!-- Card 5 -->\n  <div class=\"card card-5\"></div>\n  <div class=\"text-box extra1-box\" data-fit=\"extra1\">{{slot:extra1}}</div>\n\n  <!-- Card 6 -->\n  <div class=\"card card-6\"></div>\n  <div class=\"text-box extra2-box\" data-fit=\"extra2\">{{slot:extra2}}</div>\n  <p class=\"text-box handle-box\" data-fit=\"handle\">{{handle}}</p>\n\n</body>\n</html>"
}
