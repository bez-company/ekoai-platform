{
  "id": "antes-depois-1",
  "territory": "antes-depois",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "extra1": {
        "max": 20
      },
      "headline": {
        "max": 60
      },
      "extra2": {
        "max": 20
