{
  "id": "cartaz-retro-2",
  "territory": "cartaz-retro",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "meta": {
        "max": 20
      },
      "headline": {
        "max": 40
      },
      "support": {
        "max": 90
      }
    },
    "summary": "Pôster risografia com grid estruturado, tipografia brutalista, sobreposição de grandes formas geométricas e textura de grão de impressão."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #f4f1ea;\n      --ink: #111111;\n      --accent: #ff4a22;\n      --muted: #c4c1b9;\n      --display: 'Oswald', sans-serif;\n      --body: 'Space Grotesk', sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      margin: 0;\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* Print Grain Texture */\n    .texture {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      pointer-events: none;\n      z-index: 100;\n      opacity: 0.08;\n    }\n\n    /* Registration Marks */\n    .reg-mark {\n      position: absolute;\n      width: 20px;\n      height: 20px;\n      border: 2px solid var(--ink);\n      border-radius: 50%;\n    }\n    .reg-mark::before, .reg-mark::after {\n      content: '';\n      position: absolute;\n      background: var(--ink);\n    }\n    .reg-mark::before {\n      top: 50%; left: -6px; right: -6px; height: 2px; transform: translateY(-50%);\n    }\n    .reg-mark::after {\n      left: 50%; top: -6px; bottom: -6px; width: 2px; transform: translateX(-50%);\n    }\n    .rm-1 { top: 30px; left: 30px; }\n    .rm-2 { top: 30px; right: 30px; }\n    .rm-3 { bottom: 30px; left: 30px; }\n    .rm-4 { bottom: 30px; right: 30px; }\n\n    /* Misaligned Inner Border */\n    .frame-border {\n      position: absolute;\n      top: 60px;\n      left: 60px;\n      width: 960px;\n      height: 1230px;\n      border: 4px solid var(--ink);\n      pointer-events: none;\n      z-index: 2;\n    }\n    .frame-offset {\n      position: absolute;\n      top: 66px;\n      left: 68px;\n      width: 960px;\n      height: 1230px;\n      border: 2px solid var(--accent);\n      pointer-events: none;\n      z-index: 1;\n    }\n\n    /* Top Elements: Meta & Handle */\n    .meta-box {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 400px;\n      height: 60px;\n      overflow: hidden;\n      z-index: 10;\n    }\n    .meta-box p {\n      font-family: var(--body);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: var(--ink);\n      font-size: 26px;\n    }\n\n    .handle-box {\n      position: absolute;\n      top: 80px;\n      left: 600px;\n      width: 400px;\n      height: 60px;\n      overflow: hidden;\n      text-align: right;\n      z-index: 10;\n    }\n    .handle-box p {\n      font-family: var(--body);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: var(--ink);\n      font-size: 26px;\n    }\n\n    /* Headline */\n    .headline-box {\n      position: absolute;\n      top: 160px;\n      left: 80px;\n      width: 920px;\n      height: 380px;\n      overflow: hidden;\n      z-index: 10;\n    }\n    .headline-box h1 {\n      font-family: var(--display);\n      font-weight: bold;\n      text-transform: uppercase;\n      line-height: 0.95;\n      color: var(--ink);\n      font-size: 80px;\n    }\n\n    /* Graphic Area */\n    .graphic-box {\n      position: absolute;\n      top: 560px;\n      left: 80px;\n      width: 920px;\n      height: 480px;\n      z-index: 5;\n    }\n\n    /* Bottom Elements: Support & Logo */\n    .support-box {\n      position: absolute;\n      top: 1080px;\n      left: 80px;\n      width: 600px;\n      height: 190px;\n      overflow: hidden;\n      z-index: 10;\n    }\n    .support-box p {\n      font-family: var(--body);\n      font-weight: normal;\n      line-height: 1.4;\n      color: var(--ink);\n      font-size: 32px;\n    }\n\n    .logo-box {\n      position: absolute;\n      top: 1080px;\n      left: 760px;\n      width: 240px;\n      height: 190px;\n      display: flex;\n      justify-content: flex-end;\n      align-items: flex-end;\n      padding-bottom: 20px;\n      z-index: 10;\n    }\n    .logo-box img {\n      max-width: 100%;\n      max-height: 100px;\n      object-fit: contain;\n    }\n\n  </style>\n</head>\n<body>\n\n  <!-- Texture -->\n  <svg class=\"texture\">\n    <filter id=\"noise\">\n      <feTurbulence type=\"fractalNoise\" baseFrequency=\"0.8\" numOctaves=\"3\" stitchTiles=\"stitch\"/>\n    </filter>\n    <rect width=\"100%\" height=\"100%\" filter=\"url(#noise)\"/>\n  </svg>\n\n  <!-- Registration Marks -->\n  <div class=\"reg-mark rm-1\"></div>\n  <div class=\"reg-mark rm-2\"></div>\n  <div class=\"reg-mark rm-3\"></div>\n  <div class=\"reg-mark rm-4\"></div>\n\n  <!-- Frames -->\n  <div class=\"frame-border\"></div>\n  <div class=\"frame-offset\"></div>\n\n  <!-- Top Info -->\n  <div class=\"meta-box\">\n    <p data-fit=\"meta\">{{slot:meta}}</p>\n  </div>\n  <div class=\"handle-box\">\n    <p data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n  <!-- Headline -->\n  <div class=\"headline-box\">\n    <h1 data-fit=\"headline\">{{slot:headline}}</h1>\n  </div>\n\n  <!-- SVG Graphic -->\n  <div class=\"graphic-box\">\n    <svg width=\"920\" height=\"480\" viewBox=\"0 0 920 480\" xmlns=\"http://www.w3.org/2000/svg\">\n      <defs>\n        <pattern id=\"halftone\" x=\"0\" y=\"0\" width=\"12\" height=\"12\" patternUnits=\"userSpaceOnUse\">\n          <circle cx=\"6\" cy=\"6\" r=\"4\" fill=\"var(--ink)\" opacity=\"0.4\"/>\n        </pattern>\n      </defs>\n      \n      <!-- Halftone Arch -->\n      <path d=\"M 100 480 L 100 240 A 240 240 0 0 1 580 240 L 580 480 Z\" fill=\"url(#halftone)\" />\n      \n      <!-- Solid Accent Circle (Misregistered) -->\n      <circle cx=\"650\" cy=\"240\" r=\"180\" fill=\"var(--accent)\" opacity=\"0.9\" />\n      \n      <!-- Ink Outline Circle -->\n      <circle cx=\"630\" cy=\"255\" r=\"180\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"8\" />\n      \n      <!-- Geometric Block -->\n      <rect x=\"50\" y=\"40\" width=\"180\" height=\"180\" fill=\"var(--accent)\" opacity=\"0.8\" />\n      <rect x=\"65\" y=\"55\" width=\"180\" height=\"180\" fill=\"none\" stroke=\"var(--ink)\" stroke-width=\"6\" stroke-dasharray=\"15 10\" />\n    </svg>\n  </div>\n\n  <!-- Support Text -->\n  <div class=\"support-box\">\n    <p data-fit=\"support\">{{slot:support}}</p>\n  </div>\n\n  <!-- Logo -->\n  <div class=\"logo-box\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n</body>\n</html>"
}
