# Plataforma — copie pra .env.local (dev). Em produção, as variáveis vêm do Cloud Run.

# Postgres (server-side, nunca no client). Em produção é o Cloud SQL (SPEC 010).
DATABASE_URL=postgresql://usuario:senha@localhost:5432/ekoai

# Mídia: bucket privado do Cloud Storage, servido pela rota /api/media.
STORAGE_BUCKET=

# Gate de acesso (single-user). Senha de login + segredo pra assinar o cookie.
PLATFORM_PASSWORD=troque-isto
AUTH_SECRET=gere-um-hex-aleatorio-de-32-bytes

# Protege o endpoint do cron. Em dev, chame com o header Authorization: Bearer <CRON_SECRET>.
# Sem esta variável o endpoint recusa toda chamada.
CRON_SECRET=outro-hex-aleatorio

# Instagram Graph API
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# LinkedIn API
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=urn:li:person:xxxx

# X API (OAuth 1.0a user context; app com permissão Read and Write)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Fuso pra resolver os slots editoriais (offset fixo em horas; BRT = -3)
PUBLISH_TZ_OFFSET=-3

# Login (SPEC 009). password = senha única (padrão até a tela de login por pessoa existir);
# identity = login por pessoa pelo Identity Platform.
AUTH_PROVIDER=password
# Projeto do Identity Platform. No desenvolvimento, use o emulador:
#   npm run emulator:test (na raiz) ou firebase emulators:start --only auth --project demo-post-automation
IDENTITY_PROJECT_ID=demo-post-automation
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Geração de posts pelo Vertex AI (SPEC 012). Credencial pela ADC (gcloud auth application-default
# login) ou pela conta de serviço do Cloud Run; nada de chave aqui.
VERTEX_PROJECT_ID=ekoai-staging
VERTEX_LOCATION=global
VERTEX_TEXT_MODEL=gemini-2.5-flash
VERTEX_IMAGE_MODEL=gemini-3.1-flash-image
# Endereço público da plataforma: o pedido acorda o worker por ele (com CRON_SECRET).
APP_BASE_URL=http://localhost:3000
# Em desenvolvimento, os PNGs gerados ficam nesta pasta em vez do bucket.
# LOCAL_BLOB_DIR=.blobs

