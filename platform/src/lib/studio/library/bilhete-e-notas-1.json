{
  "id": "bilhete-e-notas-1",
  "territory": "bilhete-e-notas",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 60
      },
      "support": {
        "max": 100
      },
      "extra1": {
        "max": 80
      }
    },
    "summary": "Mesa de trabalho vista de cima com papel quadriculado, linha guia colorida e um post-it com fita adesiva."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <title>Post-it e Bilhete</title>\n  <style>\n    :root {\n      --bg: #F9F7F3;\n      --ink: #1A1A1A;\n      --accent: #E63946;\n      --muted: #8D99AE;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n      --hand: 'Caveat', cursive;\n    }\n\n    /* Reset and Base Rules */\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      margin: 0;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* Grid Paper Effect */\n    .grid-paper {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      background-image: \n        linear-gradient(color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px),\n        linear-gradient(90deg, color-mix(in srgb, var(--ink) 8%, transparent) 1px, transparent 1px);\n      background-size: 40px 40px;\n      background-position: -1px -1px;\n      z-index: 1;\n    }\n\n    /* Vertical Guide Line */\n    .guide-line {\n      position: absolute;\n      top: 0;\n      left: 160px;\n      width: 3px;\n      height: 1350px;\n      background-color: var(--accent);\n      z-index: 2;\n    }\n\n    /* Paperclip */\n    .paperclip {\n      position: absolute;\n      top: -20px;\n      left: 280px;\n      width: 40px;\n      height: 120px;\n      border: 4px solid var(--ink);\n      border-radius: 20px;\n      z-index: 3;\n    }\n    .paperclip::after {\n      content: \"\";\n      position: absolute;\n      top: -4px;\n      left: 8px;\n      width: 16px;\n      height: 90px;\n      border: 4px solid var(--ink);\n      border-top: none;\n      border-radius: 0 0 10px 10px;\n    }\n\n    /* Headline */\n    .headline-container {\n      position: absolute;\n      top: 200px;\n      left: 200px;\n      width: 800px;\n      height: 320px;\n      z-index: 10;\n      overflow: hidden;\n    }\n    .headline-text {\n      font-family: var(--display);\n      font-weight: 700;\n      color: var(--ink);\n      line-height: 1.1;\n      text-transform: uppercase;\n      font-size: 64px;\n    }\n\n    /* Scribble Underline for Headline (Using Accent) */\n    .scribble {\n      position: absolute;\n      top: 540px;\n      left: 200px;\n      width: 400px;\n      height: 12px;\n      background-color: var(--accent);\n      border-radius: 10px;\n      transform: rotate(-1deg);\n      z-index: 9;\n    }\n\n    /* Support Text */\n    .support-container {\n      position: absolute;\n      top: 580px;\n      left: 200px;\n      width: 800px;\n      height: 200px;\n      z-index: 10;\n      overflow: hidden;\n    }\n    .support-text {\n      font-family: var(--hand);\n      font-size: 48px;\n      color: color-mix(in srgb, var(--ink) 80%, var(--bg));\n      line-height: 1.2;\n    }\n\n    /* Post-it */\n    .post-it-wrapper {\n      position: absolute;\n      top: 800px;\n      left: 520px;\n      width: 460px;\n      height: 380px;\n      transform: rotate(3deg);\n      z-index: 20;\n    }\n    .post-it-bg {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      background-color: color-mix(in srgb, var(--bg) 90%, var(--ink));\n      box-shadow: 4px 8px 16px rgba(0, 0, 0, 0.15);\n    }\n    .tape {\n      position: absolute;\n      top: -15px;\n      left: 150px;\n      width: 160px;\n      height: 40px;\n      background-color: rgba(255, 255, 255, 0.4);\n      border: 1px solid rgba(0, 0, 0, 0.05);\n      transform: rotate(-4deg);\n      box-shadow: 1px 2px 4px rgba(0,0,0,0.05);\n      z-index: 22;\n    }\n    .extra1-container {\n      position: absolute;\n      top: 60px;\n      left: 40px;\n      width: 380px;\n      height: 280px;\n      overflow: hidden;\n      z-index: 21;\n    }\n    .extra1-text {\n      font-family: var(--hand);\n      font-size: 40px;\n      color: var(--ink);\n      line-height: 1.3;\n      text-align: center;\n    }\n\n    /* Footer Elements */\n    .logo-container {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 300px;\n      height: 60px;\n      z-index: 30;\n      display: flex;\n      align-items: center;\n      justify-content: flex-start;\n    }\n    .logo-container img {\n      max-width: 100%;\n      max-height: 100%;\n      object-fit: contain;\n    }\n    .handle-container {\n      position: absolute;\n      bottom: 90px;\n      right: 80px;\n      width: 400px;\n      height: 40px;\n      z-index: 30;\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: flex-end;\n    }\n    .handle-text {\n      font-family: var(--body);\n      font-weight: 700;\n      font-size: 28px;\n      color: var(--ink);\n      text-align: right;\n    }\n  </style>\n</head>\n<body>\n\n  <div class=\"grid-paper\"></div>\n  <div class=\"guide-line\"></div>\n  <div class=\"paperclip\"></div>\n\n  <div class=\"headline-container\">\n    <div class=\"headline-text\" data-fit=\"headline\">{{slot:headline}}</div>\n  </div>\n  <div class=\"scribble\"></div>\n\n  <div class=\"support-container\">\n    <div class=\"support-text\" data-fit=\"support\">{{slot:support}}</div>\n  </div>\n\n  <div class=\"post-it-wrapper\">\n    <div class=\"post-it-bg\"></div>\n    <div class=\"tape\"></div>\n    <div class=\"extra1-container\">\n      <div class=\"extra1-text\" data-fit=\"extra1\">{{slot:extra1}}</div>\n    </div>\n  </div>\n\n  <div class=\"logo-container\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"handle-container\">\n    <p class=\"handle-text\" data-fit=\"handle\">{{handle}}</p>\n  </div>\n\n</body>\n</html>"
}
