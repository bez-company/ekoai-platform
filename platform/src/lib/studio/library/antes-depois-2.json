{
  "id": "antes-depois-2",
  "territory": "antes-depois",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 80
      },
      "label1": {
        "max": 20
      },
      "label2": {
        "max": 20
      },
      "solution": {
        "max": 80
      }
    },
    "summary": "Divisão vertical 50/50 com caixas de texto defasadas e contraste de tom de fundo entre o problema e a solução."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #F9F9F7;\n      --ink: #1A1A1A;\n      --accent: #FF4500;\n      --muted: #8A8A8A;\n      --display: 'Oswald', sans-serif;\n      --body: 'Inter', sans-serif;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n      font-family: var(--body);\n      color: var(--ink);\n    }\n\n    /* Background Split */\n    .bg-left {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 540px;\n      height: 1350px;\n      background-color: color-mix(in srgb, var(--ink) 8%, var(--bg));\n    }\n\n    .bg-right {\n      position: absolute;\n      top: 0;\n      left: 540px;\n      width: 540px;\n      height: 1350px;\n      background-color: var(--bg);\n    }\n\n    /* Central Divider Line */\n    .divider {\n      position: absolute;\n      top: 0;\n      left: 538px;\n      width: 4px;\n      height: 1350px;\n      background-color: var(--accent);\n    }\n\n    /* Labels */\n    .label1-container {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 380px;\n      height: 50px;\n      overflow: hidden;\n    }\n    .label1-container p {\n      font-family: var(--body);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: var(--ink);\n      width: 100%;\n      height: 100%;\n      font-size: 26px;\n    }\n\n    .label2-container {\n      position: absolute;\n      top: 80px;\n      left: 620px;\n      width: 380px;\n      height: 50px;\n      overflow: hidden;\n    }\n    .label2-container p {\n      font-family: var(--body);\n      font-weight: bold;\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      color: var(--ink);\n      width: 100%;\n      height: 100%;\n      font-size: 26px;\n    }\n\n    /* Main Texts */\n    .headline-container {\n      position: absolute;\n      top: 250px;\n      left: 80px;\n      width: 380px;\n      height: 450px;\n      overflow: hidden;\n    }\n    .headline-container p {\n      font-family: var(--display);\n      font-weight: bold;\n      line-height: 1.1;\n      color: var(--ink);\n      width: 100%;\n      height: 100%;\n      font-size: 40px;\n    }\n\n    .solution-container {\n      position: absolute;\n      top: 650px;\n      left: 620px;\n      width: 380px;\n      height: 450px;\n      overflow: hidden;\n    }\n    .solution-container p {\n      font-family: var(--display);\n      font-weight: bold;\n      line-height: 1.1;\n      color: var(--ink);\n      width: 100%;\n      height: 100%;\n      font-size: 40px;\n    }\n\n    /* Graphic Element (Connecting Arrow) */\n    .arrow-container {\n      position: absolute;\n      top: 480px;\n      left: 480px;\n      width: 120px;\n      height: 120px;\n    }\n    .arrow-container svg {\n      width: 100%;\n      height: 100%;\n      fill: none;\n      stroke: var(--accent);\n      stroke-width: 6;\n      stroke-linecap: square;\n      stroke-linejoin: miter;\n    }\n\n    /* Footer */\n    .logo-container {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 380px;\n      height: 60px;\n      display: flex;\n      align-items: flex-end;\n      justify-content: flex-start;\n    }\n    .logo-container img {\n      max-height: 100%;\n      max-width: 100%;\n      object-fit: contain;\n    }\n\n    .handle-container {\n      position: absolute;\n      bottom: 80px;\n      left: 620px;\n      width: 380px;\n      height: 40px;\n      overflow: hidden;\n      display: flex;\n      align-items: flex-end;\n      justify-content: flex-end;\n    }\n    .handle-container p {\n      font-family: var(--body);\n      font-weight: bold;\n      text-align: right;\n      color: var(--ink);\n      width: 100%;\n      height: 100%;\n      font-size: 28px;\n    }\n  </style>\n</head>\n<body>\n  <div class=\"bg-left\"></div>\n  <div class=\"bg-right\"></div>\n  <div class=\"divider\"></div>\n\n  <div class=\"label1-container\">\n    <p data-fit=\"label1\">{{slot:label1}}</p>\n  </div>\n\n  <div class=\"headline-container\">\n    <p data-fit=\"headline\">{{slot:headline}}</p>\n  </div>\n\n  <div class=\"arrow-container\">\n    <svg viewBox=\"0 0 120 120\">\n      <path d=\"M 20 20 L 100 20 L 100 100\" />\n      <path d=\"M 80 80 L 100 100 L 120 80\" />\n    </svg>\n  </div>\n\n  <div class=\"label2-container\">\n    <p data-fit=\"label2\">{{slot:label2}}</p>\n  </div>\n\n  <div class=\"solution-container\">\n    <p data-fit=\"solution\">{{slot:solution}}</p>\n  </div>\n\n  <div class=\"logo-container\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"handle-container\">\n    <p data-fit=\"handle\">{{handle}}</p>\n  </div>\n</body>\n</html>"
}
