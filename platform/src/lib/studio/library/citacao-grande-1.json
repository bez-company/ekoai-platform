{
  "id": "citacao-grande-1",
  "territory": "citacao-grande",
  "meta": {
    "tone": "dark",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 110
      },
      "support": {
        "max": 40
      }
    },
    "summary": "Citação em corpo grande com aspas em destaque e a fonte."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n<meta charset=\"UTF-8\">\n<style>\n  :root {\n    --bg: #16161A; --ink: #F5F5F2; --accent: #E8A33D; --muted: #8A8A90;\n    --display: 'Inter', sans-serif; --body: 'Inter', sans-serif;\n  }\n  body { margin: 0; width: 1080px; height: 1350px; position: relative; overflow: hidden; background: var(--bg); color: var(--ink); font-family: var(--body); }\n  .logo { position: absolute; left: 80px; top: 80px; height: 56px; max-width: 240px; object-fit: contain; }\n  .handle { position: absolute; left: 80px; bottom: 80px; margin: 0; font: 600 28px/34px var(--body); color: var(--ink); letter-spacing: 0.01em; }\n  .rule { position: absolute; width: 120px; height: 12px; border-radius: 6px; background: var(--accent); }\n  .qmark { position: absolute; left: 80px; top: 150px; width: 300px; height: 260px; overflow: hidden; font: 800 440px/1 var(--display); color: var(--accent); }\n  .qmark::before { content: '\\201C'; }\n  .headline { position: absolute; left: 80px; top: 420px; width: 920px; height: 560px; margin: 0; overflow: hidden; font: 700 88px/1.08 var(--display); letter-spacing: -0.02em; color: var(--ink); }\n  .rule { left: 80px; top: 1030px; }\n  .support { position: absolute; left: 80px; top: 1070px; width: 760px; height: 50px; margin: 0; overflow: hidden; white-space: nowrap; font: 600 34px/50px var(--body); letter-spacing: 0.04em; color: var(--ink); }\n</style>\n</head>\n<body>\n  <div class=\"qmark\"></div>\n  <h1 class=\"headline\" data-fit=\"headline\">{{slot:headline}}</h1>\n  <div class=\"rule\"></div>\n  <p class=\"support\" data-fit=\"support\">{{slot:support}}</p>\n  <img class=\"logo\" src=\"{{logo:on-dark}}\" alt=\"Logo\">\n  <p class=\"handle\">{{handle}}</p>\n</body>\n</html>\n"
}
