{
  "id": "colagem-editorial-4",
  "territory": "colagem-editorial",
  "meta": {
    "tone": "light",
    "needsImage": true,
    "imageSlot": "A cutout of an object or person (without an identifiable face) on a transparent or completely white background. The image should be centered in the upper right area, leaving the bottom half completely free for text.",
    "slots": {
      "headline": {
        "max": 60
      },
      "support": {
        "max": 120
      },
      "extra": {
        "max": 30
      }
    },
    "summary": "Composição de colagem com um grande pedaço de papel rasgado na base, fita adesiva, textura de grão e uma imagem recortada no topo."
  },
  "html": "<!doctype html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"utf-8\">\n  <title>Collage Variant 4</title>\n  <style>\n    :root {\n      --bg: #f4f1ea;\n      --ink: #1a1a1a;\n      --accent: #d9534f;\n      --muted: #a8a39a;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n    }\n\n    body {\n      margin: 0;\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: color-mix(in srgb, var(--accent) 15%, var(--bg));\n    }\n\n    * {\n      position: absolute;\n      box-sizing: border-box;\n    }\n\n    /* Grain Texture */\n    .grain {\n      width: 1080px;\n      height: 1350px;\n      top: 0;\n      left: 0;\n      pointer-events: none;\n      z-index: 100;\n      opacity: 0.4;\n      background-image: url(\"data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E\");\n      mix-blend-mode: multiply;\n    }\n\n    /* Geometric Accent Shape */\n    .shape-circle {\n      width: 600px;\n      height: 600px;\n      border-radius: 50%;\n      background-color: var(--accent);\n      top: -100px;\n      right: -150px;\n      opacity: 0.8;\n      z-index: 1;\n    }\n\n    /* Cutout Image Area */\n    .hero-container {\n      width: 700px;\n      height: 700px;\n      top: 50px;\n      right: 40px;\n      z-index: 2;\n      filter: drop-shadow(0 20px 30px rgba(0,0,0,0.15));\n    }\n\n    .hero-container img {\n      width: 100%;\n      height: 100%;\n      object-fit: contain;\n    }\n\n    /* Torn Paper Base */\n    .paper-base {\n      width: 1080px;\n      height: 850px;\n      bottom: 0;\n      left: 0;\n      background-color: var(--bg);\n      z-index: 3;\n      clip-path: polygon(0% 8%, 3% 2%, 7% 9%, 12% 1%, 18% 11%, 23% 3%, 28% 10%, 34% 0%, 39% 12%, 45% 2%, 50% 9%, 56% 1%, 61% 11%, 67% 4%, 72% 10%, 78% 1%, 83% 12%, 89% 3%, 94% 9%, 100% 2%, 100% 100%, 0% 100%);\n      filter: drop-shadow(0 -10px 20px rgba(0,0,0,0.1));\n    }\n\n    /* Masking Tape */\n    .tape-1 {\n      width: 250px;\n      height: 45px;\n      background-color: color-mix(in srgb, var(--bg) 80%, rgba(255,255,255,0.5));\n      top: 510px;\n      left: 120px;\n      z-index: 4;\n      transform: rotate(-4deg);\n      box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n      opacity: 0.9;\n    }\n\n    .tape-2 {\n      width: 180px;\n      height: 40px;\n      background-color: color-mix(in srgb, var(--bg) 80%, rgba(255,255,255,0.5));\n      top: 480px;\n      right: 80px;\n      z-index: 4;\n      transform: rotate(7deg);\n      box-shadow: 0 2px 5px rgba(0,0,0,0.1);\n      opacity: 0.85;\n    }\n\n    /* Typography inside Paper */\n    .text-container {\n      width: 920px;\n      height: 750px;\n      bottom: 0;\n      left: 80px;\n      z-index: 5;\n    }\n\n    .extra-box {\n      width: 920px;\n      height: 40px;\n      top: 100px; /* absolute to text-container */\n      left: 0;\n      margin: 0;\n      overflow: hidden;\n    }\n\n    .extra-box p {\n      font-family: var(--body);\n      font-size: 28px;\n      font-weight: 700;\n      color: var(--accent);\n      text-transform: uppercase;\n      letter-spacing: 2px;\n      margin: 0;\n    }\n\n    .headline-box {\n      width: 920px;\n      height: 280px;\n      top: 160px;\n      left: 0;\n      margin: 0;\n      overflow: hidden;\n    }\n\n    .headline-box h1 {\n      font-family: var(--display);\n      font-size: 80px;\n      font-weight: 700;\n      color: var(--ink);\n      line-height: 1.1;\n      margin: 0;\n    }\n\n    .support-box {\n      width: 920px;\n      height: 140px;\n      top: 460px;\n      left: 0;\n      margin: 0;\n      overflow: hidden;\n    }\n\n    .support-box p {\n      font-family: var(--body);\n      font-size: 32px;\n      font-weight: 400;\n      color: color-mix(in srgb, var(--ink) 80%, var(--bg));\n      line-height: 1.4;\n      margin: 0;\n    }\n\n    .handle-box {\n      width: 400px;\n      height: 40px;\n      bottom: 80px;\n      left: 0;\n      margin: 0;\n      overflow: hidden;\n    }\n\n    .handle-box p {\n      font-family: var(--body);\n      font-size: 28px;\n      font-weight: 700;\n      color: var(--ink);\n      margin: 0;\n    }\n\n    .logo-box {\n      width: 300px;\n      height: 70px;\n      bottom: 80px;\n      right: 0;\n      display: flex;\n      justify-content: flex-end;\n      align-items: flex-end;\n    }\n\n    .logo-box img {\n      max-width: 100%;\n      max-height: 100%;\n      object-fit: contain;\n      position: relative;\n    }\n\n  </style>\n</head>\n<body>\n\n  <div class=\"grain\"></div>\n  \n  <div class=\"shape-circle\"></div>\n\n  <div class=\"hero-container\">\n    <img src=\"{{asset:hero}}\" alt=\"Cutout Image\">\n  </div>\n\n  <div class=\"paper-base\"></div>\n  \n  <div class=\"tape-1\"></div>\n  <div class=\"tape-2\"></div>\n\n  <div class=\"text-container\">\n    <div class=\"extra-box\">\n      <p data-fit=\"extra\">{{slot:extra}}</p>\n    </div>\n\n    <div class=\"headline-box\">\n      <h1 data-fit=\"headline\">{{slot:headline}}</h1>\n    </div>\n\n    <div class=\"support-box\">\n      <p data-fit=\"support\">{{slot:support}}</p>\n    </div>\n\n    <div class=\"handle-box\">\n      <p data-fit=\"handle\">{{handle}}</p>\n    </div>\n\n    <div class=\"logo-box\">\n      <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n    </div>\n  </div>\n\n</body>\n</html>"
}
