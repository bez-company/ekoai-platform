{
  "name": "post-automation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ekoai: plataforma para empresas cuidarem do Instagram. Jobs de apoio (métricas, tokens, migrations) para o Cloud Run.",
  "main": "src/jobs.js",
  "scripts": {
    "refresh-tokens": "node src/refresh-tokens.js",
    "metrics": "node src/metrics.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "tenant:create": "node scripts/create-tenant.js",
    "access:grant": "node scripts/grant-access.js",
    "migrate": "node scripts/migrate.js",
    "test:emulator": "vitest run --config vitest.emulator.config.js",
    "test:db": "vitest run --config vitest.db.config.js",
    "emulator:test": "npx -y firebase-tools@15.34.0 emulators:exec --only auth --project demo-post-automation \"npm run test:emulator\""
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@ekoai/db": "file:packages/db",
    "@google-cloud/secret-manager": "^7.2.0",
    "@google-cloud/storage": "^8.4.0",
    "@sentry/node": "^10.76.2",
    "dotenv": "^16.4.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "vitest": "^5.0.5"
  }
}
