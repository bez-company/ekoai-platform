{
  "id": "diagrama-didatico-1",
  "territory": "diagrama-didatico",
  "meta": {
    "tone": "light",
    "needsImage": false,
    "imageSlot": null,
    "slots": {
      "headline": {
        "max": 60
      },
      "support": {
        "max": 100
      },
      "step1": {
        "max": 70
      },
      "step2": {
        "max": 70
      },
      "step3": {
        "max": 70
      },
      "nome": {
        "max": 30
      }
    },
    "summary": "Diagrama de fluxo estilo anotação de caderno com 3 passos ziguezagueantes e setas desenhadas à mão."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #F9F7F3;\n      --ink: #2D2A26;\n      --accent: #E63946;\n      --muted: #A8A6A1;\n      --display: 'Space Grotesk', sans-serif;\n      --body: 'Inter', sans-serif;\n      --hand: 'Caveat', cursive;\n    }\n\n    * {\n      box-sizing: border-box;\n      margin: 0;\n      padding: 0;\n    }\n\n    body {\n      width: 1080px;\n      height: 1350px;\n      background-color: var(--bg);\n      position: relative;\n      overflow: hidden;\n      font-family: var(--body);\n      color: var(--ink);\n      background-image: radial-gradient(color-mix(in srgb, var(--ink) 10%, transparent) 1px, transparent 1px);\n      background-size: 30px 30px;\n    }\n\n    /* SVG Arrows */\n    .arrows {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      z-index: 1;\n      pointer-events: none;\n    }\n\n    .arrow-path {\n      fill: none;\n      stroke: var(--accent);\n      stroke-width: 6;\n      stroke-linecap: round;\n      stroke-linejoin: round;\n      stroke-dasharray: 12 12;\n    }\n\n    .arrow-head {\n      fill: var(--accent);\n    }\n\n    /* Slots and Containers */\n    .headline-container {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 920px;\n      height: 140px;\n      overflow: hidden;\n      z-index: 2;\n    }\n\n    .headline {\n      font-family: var(--display);\n      font-size: 64px;\n      font-weight: 700;\n      line-height: 1.1;\n      color: var(--ink);\n    }\n\n    .support-container {\n      position: absolute;\n      top: 240px;\n      left: 80px;\n      width: 920px;\n      height: 100px;\n      overflow: hidden;\n      z-index: 2;\n    }\n\n    .support {\n      font-size: 32px;\n      font-weight: 400;\n      line-height: 1.3;\n      color: var(--ink);\n    }\n\n    /* Steps */\n    .step {\n      position: absolute;\n      width: 440px;\n      height: 200px;\n      z-index: 2;\n    }\n\n    .step::before {\n      position: absolute;\n      left: -90px;\n      top: -20px;\n      font-family: var(--hand);\n      font-size: 120px;\n      font-weight: 700;\n      color: var(--accent);\n      line-height: 1;\n    }\n\n    .step-1 { top: 380px; left: 170px; }\n    .step-1::before { content: \"1\"; }\n\n    .step-2 { top: 660px; left: 550px; }\n    .step-2::before { content: \"2\"; }\n\n    .step-3 { top: 940px; left: 170px; }\n    .step-3::before { content: \"3\"; }\n\n    .step-text-container {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 100%;\n      height: 100%;\n      overflow: hidden;\n      background: var(--bg);\n      border: 3px solid var(--ink);\n      border-radius: 16px;\n      padding: 24px;\n      box-shadow: 8px 8px 0px color-mix(in srgb, var(--ink) 15%, var(--bg));\n    }\n\n    .step-text {\n      font-family: var(--hand);\n      font-size: 36px;\n      font-weight: 700;\n      line-height: 1.2;\n      color: var(--ink);\n    }\n\n    /* Footer */\n    .logo-container {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 250px;\n      height: 80px;\n      z-index: 2;\n      display: flex;\n      align-items: center;\n    }\n\n    .logo-container img {\n      max-width: 100%;\n      max-height: 100%;\n      object-fit: contain;\n    }\n\n    .handle-container {\n      position: absolute;\n      bottom: 80px;\n      right: 80px;\n      width: 600px;\n      height: 80px;\n      overflow: hidden;\n      z-index: 2;\n      display: flex;\n      justify-content: flex-end;\n      align-items: center;\n      text-align: right;\n    }\n\n    .handle {\n      font-family: var(--display);\n      font-size: 28px;\n      font-weight: 700;\n      color: var(--ink);\n    }\n\n  </style>\n</head>\n<body>\n\n  <!-- Background SVG Graphics -->\n  <svg class=\"arrows\" viewBox=\"0 0 1080 1350\">\n    <!-- Arrow 1 to 2 -->\n    <path class=\"arrow-path\" d=\"M 610 480 Q 770 480 770 630\" />\n    <polygon class=\"arrow-head\" points=\"770,650 755,620 785,620\" />\n    \n    <!-- Arrow 2 to 3 -->\n    <path class=\"arrow-path\" d=\"M 550 760 Q 390 760 390 910\" />\n    <polygon class=\"arrow-head\" points=\"390,930 375,900 405,900\" />\n  </svg>\n\n  <div class=\"headline-container\">\n    <div class=\"headline\" data-fit=\"headline\">{{slot:headline}}</div>\n  </div>\n\n  <div class=\"support-container\">\n    <div class=\"support\" data-fit=\"support\">{{slot:support}}</div>\n  </div>\n\n  <div class=\"step step-1\">\n    <div class=\"step-text-container\">\n      <div class=\"step-text\" data-fit=\"step1\">{{slot:step1}}</div>\n    </div>\n  </div>\n\n  <div class=\"step step-2\">\n    <div class=\"step-text-container\">\n      <div class=\"step-text\" data-fit=\"step2\">{{slot:step2}}</div>\n    </div>\n  </div>\n\n  <div class=\"step step-3\">\n    <div class=\"step-text-container\">\n      <div class=\"step-text\" data-fit=\"step3\">{{slot:step3}}</div>\n    </div>\n  </div>\n\n  <div class=\"logo-container\">\n    <img src=\"{{logo:on-light}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"handle-container\">\n    <div class=\"handle\" data-fit=\"nome\">{{slot:nome}}</div>\n  </div>\n\n</body>\n</html>"
}
