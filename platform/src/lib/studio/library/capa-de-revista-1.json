{
  "id": "capa-de-revista-1",
  "territory": "capa-de-revista",
  "meta": {
    "tone": "dark",
    "needsImage": true,
    "imageSlot": "Uma imagem forte, como um retrato ou objeto centralizado, com espaço livre nas laterais médias para as caixas de texto.",
    "slots": {
      "headline": {
        "max": 60
      },
      "callout1": {
        "max": 80
      },
      "callout2": {
        "max": 80
      }
    },
    "summary": "Capa de revista com hierarquia de banca, manchete gigante na base e chamadas laterais em caixas sólidas."
  },
  "html": "<!DOCTYPE html>\n<html lang=\"pt-BR\">\n<head>\n  <meta charset=\"UTF-8\">\n  <style>\n    :root {\n      --bg: #111111;\n      --ink: #ffffff;\n      --accent: #ff3366;\n      --muted: #888888;\n      --display: 'Playfair Display', serif;\n      --body: 'Inter', sans-serif;\n    }\n\n    body {\n      margin: 0;\n      width: 1080px;\n      height: 1350px;\n      position: relative;\n      overflow: hidden;\n      background-color: var(--bg);\n    }\n\n    .hero-image {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      object-fit: cover;\n      z-index: 1;\n    }\n\n    .protection-overlay {\n      position: absolute;\n      top: 0;\n      left: 0;\n      width: 1080px;\n      height: 1350px;\n      background: linear-gradient(\n        to bottom,\n        var(--bg) 0%,\n        var(--bg) 15%,\n        transparent 35%,\n        transparent 55%,\n        var(--bg) 75%,\n        var(--bg) 100%\n      );\n      z-index: 2;\n    }\n\n    .logo-container {\n      position: absolute;\n      top: 80px;\n      left: 80px;\n      width: 920px;\n      height: 80px;\n      display: flex;\n      justify-content: center;\n      align-items: center;\n      z-index: 3;\n    }\n\n    .logo-container img {\n      max-height: 80px;\n      max-width: 100%;\n      object-fit: contain;\n    }\n\n    .callout {\n      position: absolute;\n      background-color: var(--bg);\n      border-left: 8px solid var(--accent);\n      z-index: 3;\n    }\n\n    .callout-1 {\n      top: 380px;\n      left: 80px;\n      width: 360px;\n      height: 180px;\n    }\n\n    .callout-2 {\n      top: 620px;\n      right: 80px;\n      width: 360px;\n      height: 180px;\n    }\n\n    .callout-text {\n      position: absolute;\n      top: 20px;\n      left: 24px;\n      width: 316px;\n      height: 140px;\n      margin: 0;\n      overflow: hidden;\n      font-family: var(--body);\n      color: var(--ink);\n      font-size: 28px;\n      line-height: 1.3;\n      font-weight: bold;\n      text-transform: uppercase;\n    }\n\n    .headline {\n      position: absolute;\n      bottom: 160px;\n      left: 80px;\n      width: 920px;\n      height: 320px;\n      margin: 0;\n      overflow: hidden;\n      font-family: var(--display);\n      color: var(--ink);\n      font-size: 110px;\n      line-height: 1.05;\n      text-align: center;\n      text-transform: uppercase;\n      z-index: 3;\n      display: flex;\n      align-items: flex-end;\n      justify-content: center;\n    }\n\n    .handle {\n      position: absolute;\n      bottom: 80px;\n      left: 80px;\n      width: 920px;\n      height: 40px;\n      margin: 0;\n      overflow: hidden;\n      font-family: var(--body);\n      color: var(--ink);\n      font-size: 28px;\n      line-height: 40px;\n      text-align: center;\n      letter-spacing: 2px;\n      z-index: 3;\n    }\n  </style>\n</head>\n<body>\n  <img class=\"hero-image\" src=\"{{asset:hero}}\" alt=\"Background\">\n  <div class=\"protection-overlay\"></div>\n\n  <div class=\"logo-container\">\n    <img src=\"{{logo:on-dark}}\" alt=\"Logo\">\n  </div>\n\n  <div class=\"callout callout-1\">\n    <div class=\"callout-text\" data-fit=\"callout1\">{{slot:callout1}}</div>\n  </div>\n\n  <div class=\"callout callout-2\">\n    <div class=\"callout-text\" data-fit=\"callout2\">{{slot:callout2}}</div>\n  </div>\n\n  <div class=\"headline\" data-fit=\"headline\">{{slot:headline}}</div>\n\n  <div class=\"handle\" data-fit=\"handle\">{{handle}}</div>\n</body>\n</html>"
}
